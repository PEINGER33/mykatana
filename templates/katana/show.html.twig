{% extends 'base.html.twig' %}

{% block title %}Katana n°{{ katana.id }}{% endblock %}

{% block body %}
    <h1>Katana</h1>

       {% dump katana %}

    <table class="table">
        <tbody>
            <tr>
                <th>Description</th>
                <td>{{ katana.description }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ katana.type }}</td>
            </tr>
            <tr>
                <th>Longueur</th>
                <td>{{ katana.longueur }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('trousseau_show', {'id': katana.trousseau.id}) }}">back to trousseau {{ katana.trousseau.id }}</a>

{% endblock %} {# body #} 
{# ... #} 

