{% extends 'base.html.twig' %}

{% block title %}Katana{% endblock %}

{% block main %}
    <h1>Katana</h1>
	
	{% dump(katana) %}
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ katana.id }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ katana.description }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ katana.type }}</td>
            </tr>
            <tr>
                <th>Longueur</th>
                <td>{{ katana.longueur }}</td>
            </tr>
            <tr>
    			<th>Image</th>
    			<td>
                    {% if katana.imageName %}
            			<img src="{{ vich_uploader_asset(katana, 'imageFile') }}" alt="Image du katana" style="max-width: 300px;">
                    {% else %}
            			<em>Aucune image</em>
       				{% endif %}
    			</td>
			</tr>
        </tbody>
    </table>

    <a href="{{ path('app_katana_index') }}">back to list</a>

    <a href="{{ path('app_katana_edit', {'id': katana.id}) }}">edit</a>

    {{ include('katana/_delete_form.html.twig') }}
{% endblock %}
