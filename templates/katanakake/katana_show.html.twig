{% extends 'base.html.twig' %}

{% block title %}Katana n°{{ katana.id }}{% endblock %}

{% block main %}
    <h1>Katana</h1>

       {% dump katana %}

    <table class="table">
        <tbody>
            <tr>
                <th>Description</th>
                <td>{{ katana.description }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ katana.type }}</td>
            </tr>
            <tr>
                <th>Longueur</th>
                <td>{{ katana.longueur }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_katanakake_show', {'id': katanakake.id}) }}">back to katanakake {{ katanakake.id }}</a>

{% endblock %} {# main #} 
