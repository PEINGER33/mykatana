{% extends 'base.html.twig' %}

{% block title %}Katanakake{% endblock %}

{% block main %}
    <h1>Katanakake</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ katanakake.id }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ katanakake.description }}</td>
            </tr>
            <tr>
                <th>Publiée</th>
                <td>{{ katanakake.publiee ? 'Yes' : 'No' }}</td>
            </tr>
            
            {# Présentation des Katanas présent dans le Katanakake #}
            <tr>
    			<th>Katanas</th>
    			<td>
        			<ul>
            {# {% for katana in katanakake.katanas %}
          				 <li>
     						<a href="{{ path( 'app_katanakake_katana_show',{'katanakake_id': katanakake.id,'katana_id' : katana.id}) }}">{{ katana }}</a>
   						</li>
                      {% endfor %}   #}
                      
               {% for katana in katanakake.katanas %}
                <li style="margin-bottom: .5rem;">
                    {% if katana.imageName %}
                        <img
                            src="{{ vich_uploader_asset(katana, 'imageFile') }}"
                            alt="{{ katana.description }}"
                            style="max-width: 100px; vertical-align: middle; margin-right: .5rem;"
                        >
                    {% endif %}
                    {#}<a href="{{ path('app_katana_show', {'id': katana.id}) }}">
                        {{ katana.description }}
                    </a>#}
                    <a href="{{ path( 'app_katanakake_katana_show',{'katanakake_id': katanakake.id,'katana_id' : katana.id}) }}">{{ katana }}</a>
                </li>
            {% endfor %}       
        			</ul>
    			</td>
			</tr>
			
        </tbody>
    </table>

    {#<a href="{{ path('app_katanakake_index') }}">back to katanakake index</a>#}
    <a href="{{ path('app_member_show', {'id': katanakake.createur.id}) }}"class="btn btn-secondary"> back to member</a>

    <a href="{{ path('app_katanakake_edit', {'id': katanakake.id}) }}">edit</a>

    {{ include('katanakake/_delete_form.html.twig') }}
{% endblock %}
