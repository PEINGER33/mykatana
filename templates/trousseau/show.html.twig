{% extends 'base.html.twig' %}
{% block title %}Trousseau n°{{ trousseau.id }}{% endblock %}

{% block main %}
    <h1>Trousseau n°{{ trousseau.id }}</h1>

       {% dump trousseau %}

    <table class="table">
        <tbody>
            <tr>
                <th>Description</th>
                <td>{{ trousseau.description }}</td>
            </tr>
            <tr>
                  <th>Katanas</th>
                  <td>
                  <ul>
                  {%  for katana in trousseau.katanas %}
                  <li>
                  <a href="{{ path('app_katana_show', {'id': katana.id}) }}"> {{ katana.description }} </a>
                  </li>
                  {% endfor %} {# trousseau.katanas #}
                  </ul> 
                  </td>
              </tr>
        </tbody>
    </table>

	<a href="{{ path('app_katana_new', {'id': trousseau.id}) }} " class="btn btn-primary me-2">Ajouter Katana</a>
    <a href="{{ path('app_member_show', {'id': trousseau.member.id}) }}" class="btn btn-secondary">Retour au membre</a>
    

{% endblock %} {# main #} 
{# ... #} 
