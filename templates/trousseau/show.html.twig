{% extends 'base.html.twig' %}
{% block title %}Trousseau n°{{ trousseau.id }}{% endblock %}

{% block main %}
    <h1>Trousseau</h1>

       {% dump trousseau %}

    <table class="table">
        <tbody>
            <tr>
                <th>Description</th>
                <td>{{ trousseau.description }}</td>
            </tr>
            <tr>
                  <th>Katanas</th>
                  <td>
                  <ul>
                  {%  for katana in trousseau.katanas %}
                  <li>
                  <a href="{{ path('katana_show', {'id': katana.id}) }}"> {{ katana.description }} </a>
                  </li>
                  {% endfor %} {# trousseau.katanas #}
                  </ul> 
                  </td>
              </tr>
        </tbody>
    </table>

    <a href="{{ path('trousseau_index') }}">back to list</a>

{% endblock %} {# main #} 
{# ... #} 
